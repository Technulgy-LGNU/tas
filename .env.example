# Docker Compose deployment options only. TAS itself reads the mounted TOML.
TAS_CONFIG_FILE=./config.toml
# Published by the GitHub workflow. Use its release tag or full commit SHA to pin.
TAS_IMAGE=ghcr.io/technulgy-lgnu/tas:latest
TAS_BIND_ADDRESS=127.0.0.1
TAS_PORT=2005

# Must equal [database].password in the TOML; change both before starting.
# Compose uses this only to initialize the bundled PostgreSQL service.
POSTGRES_PASSWORD=change-me
